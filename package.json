    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "@types/node": "^22.15.0",
    "playwright": "^1.64.0"
  }
